# Copy to .env and fill in real values. Never commit .env.
# ── Spotify ───────────────────────────────────────────────────────────────
SPOTIFY_CLIENT_ID=your_client_id_here
SPOTIFY_CLIENT_SECRET=your_client_secret_here
SPOTIFY_REFRESH_TOKEN=your_refresh_token_here   # get via: python scripts/get_spotify_token.py

# ── GCP ───────────────────────────────────────────────────────────────────
GCP_PROJECT_ID=your-gcp-project-id
GCS_BUCKET=your-gcp-project-id-spotify-raw      # matches terraform output
BQ_DATASET=spotify_warehouse
GOOGLE_APPLICATION_CREDENTIALS=./keys/service_account.json

# ── Terraform / Vercel (only needed for terraform apply) ──────────────────
# TF_VAR_vercel_api_token=your_vercel_token
